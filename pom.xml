<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>ebirrToken</groupId>
    <artifactId>ebirrToken</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>ebirrToken</name>
    <packaging>jar</packaging>

    <properties>
        <CApp.type>lib/synapse/mediator</CApp.type>
        <!-- Align Java version -->
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <!-- Use properties for plugin versions for easier updates -->
        <maven.compiler.plugin.version>3.8.1</maven.compiler.plugin.version>
        <maven.shade.plugin.version>3.5.2</maven.shade.plugin.version>
        <jackson.version>2.17.0</jackson.version>
    </properties>

    <build>
        <!-- Removed sourceDirectory to follow Maven conventions -->
        <plugins>
            <!-- Compiler plugin -->
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven.compiler.plugin.version}</version>
                <configuration>
                    <source>${maven.compiler.source}</source>
                    <target>${maven.compiler.target}</target>
                </configuration>
            </plugin>

            <!-- Shade plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>${maven.shade.plugin.version}</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <artifactSet>
                                <includes>
                                    <include>com.auth0:java-jwt</include>
                                </includes>
                            </artifactSet>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <dependency>
            <groupId>com.auth0</groupId>
            <artifactId>java-jwt</artifactId>
            <version>4.4.0</version>
        </dependency>

        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>

       <dependency>
  <groupId>org.wso2.orbit.commons-codec</groupId>
  <artifactId>commons-codec</artifactId>
  <version>1.15.0.wso2v1</version>
</dependency>


        <dependency>
            <groupId>commons-io.wso2</groupId>
            <artifactId>commons-io</artifactId>
            <version>2.4.0.wso2v1</version>
        </dependency>

        <dependency>
  <groupId>org.apache.synapse</groupId>
  <artifactId>synapse-core</artifactId>
  <version>3.0.2</version>
</dependency>


       <dependency>
  <groupId>org.apache.ws.commons.schema</groupId>
  <artifactId>XmlSchema</artifactId>
  <version>1.4.7</version>
</dependency>


        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-xml</artifactId>
            <version>${jackson.version}</version>
        </dependency>

        <dependency>
            <groupId>commons-logging</groupId>
            <artifactId>commons-logging</artifactId>
            <version>1.2</version>
            <scope>provided</scope>
        </dependency>
        <!-- WSO2 URI Template -->
<dependency>
    <groupId>org.wso2.uri.template</groupId>
    <artifactId>wso2-uri-templates</artifactId>
    <version>1.0.0</version>
</dependency>

<!-- WSO2 Caching Core -->
<dependency>
    <groupId>org.wso2.caching</groupId>
    <artifactId>wso2caching-core</artifactId>
    <version>3.5.0</version>
</dependency>

<!-- WSO2 Eventing API -->
<dependency>
    <groupId>org.wso2.eventing</groupId>
    <artifactId>wso2eventing-api</artifactId>
    <version>2.1</version>
</dependency>
        <!-- https://mvnrepository.com/artifact/org.apache.synapse/synapse-commons -->
<dependency>
  <groupId>org.apache.synapse</groupId>
  <artifactId>synapse-commons</artifactId>
  <version>4.0.0-wso2v1</version>
</dependency>
    </dependencies>
<repositories>
    <repository>
        <id>central</id>
        <url>https://repo.maven.apache.org/maven2/</url>
    </repository>

    <!-- This WSO2 repo hosts all WSO2 artifacts -->
    <repository>
        <id>wso2-maven2-repo</id>
        <url>https://maven.wso2.org/nexus/content/repositories/releases/</url>
    </repository>

    <!-- WSO2 public group repo -->
    <repository>
        <id>wso2-public</id>
        <url>http://maven.wso2.org/nexus/content/groups/wso2-public/</url>
        <releases>
            <enabled>true</enabled>
            <updatePolicy>always</updatePolicy>
            <checksumPolicy>warn</checksumPolicy>
        </releases>
    </repository>
</repositories>

</project>
